{
    "name": "exercism/php",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "league/flysystem": "^3.36",
        "nikic/php-parser": "^5.0",
        "symfony/console": "7.4.*",
        "symfony/http-client": "7.4.*"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59.0",
        "league/flysystem-memory": "^3.31",
        "phpunit/phpunit": "^13.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": ["mago format --check", "mago lint", "mago analyze"],
        "lint:fix": "mago fix"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
