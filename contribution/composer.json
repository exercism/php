{
    "name": "exercism/php",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "brick/varexporter": "^0.7.0",
        "league/flysystem": "^3.36",
        "nikic/php-parser": "^5.0",
        "php-collective/toml": "^0.1.5",
        "symfony/console": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/process": "^7.4",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "carthage-software/mago": "^1.59.0",
        "league/flysystem-memory": "^3.31",
        "phpunit/phpunit": "^13.0"
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "lint": ["mago format --check", "mago lint", "mago analyze"],
        "lint:fix": "mago fix"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
